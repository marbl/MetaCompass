// -----------------------------------------------------------------------------
// Executor settings
// -----------------------------------------------------------------------------
executor {
    // Number of parallel jobs submitted at the same time when running locally
    queueSize = 2
}

// -----------------------------------------------------------------------------
// Pipeline parameters
// -----------------------------------------------------------------------------
params {
    // Run options
    trace_file_name = 'trace.txt'
    run_valet       = false
    scaffolding     = false
    frc_curves      = false
    ref_info        = false

    // Required inputs
    forward      = ''
    reverse      = ''
    unpaired     = ''
    output       = ''
    reference_db = ''

    // Optional pipeline flags used by the updated workflow
    skip_rs  = false
    skip_rc  = false
    clean_uf = false
    de_novo  = 1
    help     = false

    // -------------------------------------------------------------------------
    // Reference selection
    // -------------------------------------------------------------------------
    filter_refs = false
    ms          = 28
    clean       = 0.0
    match       = 0.01
    masking     = '-nomasking'
    readlen     = '300'

    // -------------------------------------------------------------------------
    // Reference clustering
    // -------------------------------------------------------------------------
    depth_of_coverage       = 1
    breadth_of_coverage     = 0.9
    percent_markers_covered = 75

    // -------------------------------------------------------------------------
    // Reference culling
    // -------------------------------------------------------------------------
    ref_culling_ms = 16
    num_matches    = 2
    stop           = 0.01

    // -------------------------------------------------------------------------
    // Reference-guided assembly
    // -------------------------------------------------------------------------
    valet_path = '/fs/cbcb-lab/mpop/Valet/VALET/bin/valet.sh'

    flank    = '5'
    mindepth = '3'
    ref_sel  = 'tax'
    ref_pick = 'breadth'
    mincov   = '1'
    minctglen = '1'
    tracks   = false
    threads  = '16'
    memory   = '20'

    // -------------------------------------------------------------------------
    // Scaffolding
    // -------------------------------------------------------------------------
    metacarvel_path = 'run.py'

    // -------------------------------------------------------------------------
    // Report generation
    // -------------------------------------------------------------------------
    frc_path       = 'FRC/get_FRC_data'
    libsize_avg    = 165
    libsize_sdv    = 92.8
    orientation_a  = '+'
    orientation_b  = '-'

    mp_size_z_cutoff = 2.58
    mp_edge_z_cutoff = 2.58
    doc_logp_cutoff  = 7
}

// -----------------------------------------------------------------------------
// Trace
// -----------------------------------------------------------------------------
trace {
    enabled   = true
    overwrite = true
    file      = params.trace_file_name
    fields    = 'task_id,name,status,exit,submit,start,duration,realtime,%cpu,%mem,read_bytes,write_bytes'
}